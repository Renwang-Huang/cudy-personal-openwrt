/dts-v1/;

#include "mt7628an.dtsi"

#include <dt-bindings/input/input.h>
#include <dt-bindings/gpio/gpio.h>

/ {
	compatible = "OEM,MT7628", "mediatek,mt7628an-soc";
	model = "R46";

	chosen {
		bootargs = "console=ttyS0,115200";
	};

	memory@0 {
		device_type = "memory";
		reg = <0x0 0x8000000>;
	};

	gpio-leds {
		compatible = "gpio-leds";
		blue {
			label = "oem:green:blue";
			gpios = <&gpio1 11 GPIO_ACTIVE_LOW>;
		};

		red {
			label = "oem:green:red";
			gpios = <&gpio1 12 GPIO_ACTIVE_LOW>;
		};
	};

	gpio_export {
		compatible = "gpio-export";
		#size-cells = <0>;

		usb {
			gpio-export,name = "usb";
			gpio-export,output = <1>;
			gpios = <&gpio0 4 GPIO_ACTIVE_HIGH>;
		};
	};

	gpio-keys-polled {
		compatible = "gpio-keys-polled";
		#address-cells = <1>;
		#size-cells = <0>;
		poll-interval = <20>;
		reset {
			label = "reset";
			gpios = <&gpio0 11 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_RESTART>;
		};

		mulplex {
			label = "mulplex";
			gpios = <&gpio1 6 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_SETUP>;
		};
	};
};

&ethernet {
	mtd-mac-address = <&bdinfo 0xDE00>;
	mediatek,port-map = "lllwl";
};

&pinctrl {
	state_default: pinctrl0 {
		gpio {
			ralink,group = "refclk", "wled_an", "gpio", "spi cs1";
			ralink,function = "gpio";
		};
	};
};

&wmac {
	status = "okay";
};

&pcie {
	status = "okay";
};

&spi0 {
	status = "okay";

	m25p80@0 {
		#address-cells = <1>;
		#size-cells = <1>;
		compatible = "jedec,spi-nor";
		reg = <0>;
		spi-max-frequency = <10000000>;
		m25p,chunked-io = <32>;

		partition@0 {
			label = "u-boot";
			reg = <0x0 0x30000>;
		};

		partition@30000 {
			label = "u-boot-env";
			reg = <0x30000 0x10000>;
		};

		factory: partition@40000 {
			label = "factory";
			reg = <0x40000 0x10000>;
		};

		debug: partition@fd0000 {
			label = "debug";
			reg = <0xfd0000 0x10000>;
		};

		backup: partition@fe0000 {
			label = "backup";
			reg = <0xfe0000 0x10000>;
		};

		bdinfo: partition@ff0000 {
			label = "bdinfo";
			reg = <0xff0000 0x10000>;
		};

		partition@50000 {
			label = "firmware";
			reg = <0x50000 0xf80000>;
		};
	};
};
