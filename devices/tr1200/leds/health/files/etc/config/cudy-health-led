	option enabled '1'
	option interval '30'
	option failures '3'
	option recoveries '2'
	option boot_grace '300'
	option minimum_memory_kib '4096'
	option minimum_overlay_kib '256'
	list probe_url 'https://www.gstatic.com/generate_204'
	list probe_url 'https://cp.cloudflare.com/generate_204'
