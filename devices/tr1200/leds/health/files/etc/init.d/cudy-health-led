#!/bin/sh /etc/rc.common
# shellcheck shell=dash disable=SC2034
# Health reporting only; procd manages the observer's own lifetime.
USE_PROCD=1
START=99
STOP=01

start_service() {
	local enabled
	config_load cudy-health-led
	config_get_bool enabled main enabled 1
	[ "$enabled" = 1 ] || return 0
	procd_open_instance
	procd_set_param command /usr/libexec/cudy-health-led --daemon
	procd_set_param respawn 3600 5 5
	procd_set_param file /etc/config/cudy-health-led
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger cudy-health-led
}
